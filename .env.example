# Deskline environment variables (all optional).
#
# Deskline boots with no environment at all: every value below has a working
# default. Copy this file's contents into your process environment (systemd
# `Environment=`, Docker `-e`, `export ...`) when you want to override them.
# Note: the app reads the real process environment; it does not load this file.

# Secret key used to sign sessions and CSRF tokens. Set a long random value in
# production. Development fallback lives in deskline/settings.py.
DJANGO_SECRET_KEY=

# "false" disables Django debug pages (also run collectstatic then).
DJANGO_DEBUG=true

# Optional Postgres datasource. Leave empty to use ./db.sqlite3.
# Example: postgres://deskline:***REDACTED-SECRET***@127.0.0.1:5432/deskline
DATABASE_URL=

# First-response SLA window applied to every new ticket, in hours.
DESKLINE_SLA_HOURS=8

# Tickets inside this many hours of their deadline show the "Due soon" badge.
DESKLINE_SLA_DUE_SOON_HOURS=4
